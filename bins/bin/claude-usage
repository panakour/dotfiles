#!/bin/sh
set -eu

token() {
  if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
    printf '%s' "$CLAUDE_CODE_OAUTH_TOKEN"
    return
  fi
  file="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json"
  if [ -f "$file" ]; then
    jq -r '.claudeAiOauth.accessToken' "$file"
  else
    security find-generic-password -s "Claude Code-credentials" -w | jq -r '.claudeAiOauth.accessToken'
  fi
}

wait_key() {
  [ -t 0 ] || return 0
  printf ' \033[2many key to close\033[0m'
  stty -echo -icanon; dd bs=1 count=1 2>/dev/null >/dev/null; stty echo icanon
}

resets() {
  [ -n "$1" ] || return 0
  epoch=$(/bin/date -j -u -f "%Y-%m-%dT%H:%M:%S" "$(printf '%s' "$1" | cut -c1-19)" +%s)
  mins=$(((epoch - $(date +%s)) / 60))
  if [ "$mins" -lt 60 ]; then printf 'resets in %dm' "$mins"
  elif [ "$mins" -lt 1440 ]; then printf 'resets in %dh %02dm' $((mins / 60)) $((mins % 60))
  else printf 'resets %s' "$(/bin/date -r "$epoch" '+%a %-I:%M %p')"
  fi
}

repeat() {
  i=0; while [ "$i" -lt "$2" ]; do printf '%s' "$1"; i=$((i + 1)); done
}

row() {
  label=$1 right=$2 pct=$3
  color=34; [ "$pct" -ge 70 ] && color=33; [ "$pct" -ge 90 ] && color=31
  space=$((inner - ${#label} - ${#right}))
  if [ "$space" -lt 2 ]; then
    right="" space=$((inner - ${#label}))
    [ "$space" -ge 0 ] || { label=$(printf '%.*s' "$inner" "$label"); space=0; }
  fi
  printf ' \033[1m%s\033[0m%*s\033[2m%s\033[0m\n' "$label" "$space" "" "$right"
  fill=$((pct * bar_w / 100)); [ "$fill" -le "$bar_w" ] || fill=$bar_w
  printf ' \033[%sm' "$color"; repeat '█' "$fill"
  printf '\033[0;2m'; repeat '░' $((bar_w - fill))
  printf '\033[0;%s;1m%5s\033[0m\n' "$color" "${pct}%"
  [ "$gap" -eq 0 ] || printf '\n'
}

out=$(curl -s --max-time 15 -w '\n%{http_code}' https://api.anthropic.com/api/oauth/usage \
  -H "Authorization: Bearer $(token)" \
  -H "anthropic-beta: oauth-2025-04-20") || out="
000"
status=${out##*
}
if [ "$status" != 200 ]; then
  printf ' \033[31mCould not load usage\033[0m \033[2m(HTTP %s)\033[0m\n' "$status"
  wait_key; exit 1
fi

rows=$(printf '%s' "${out%
*}" | jq -r '
  def money: "$\(. / 100 | floor).\(. % 100 | tostring | ("0" + .)[-2:])";
  (.limits[] | [
    (if .kind == "session" then "5-hour"
     elif .kind == "weekly_all" then "Weekly · all models"
     else "Weekly · " + (.scope.model.display_name // .scope.surface // "other") end),
    .percent, (.resets_at // "")
  ]),
  (.spend | select(.enabled == true) | [
    "Extra usage", .percent,
    "\(.used.amount_minor | money) / \(.limit.amount_minor | money)"
  ]) | @tsv')

size=$( { stty size </dev/tty; } 2>/dev/null || echo "24 80")
lines=${size% *} cols=${size#* }
inner=$((cols - 2)); [ "$inner" -ge 20 ] || inner=20
bar_w=$((inner - 6))
gap=1; [ $(( $(printf '%s\n' "$rows" | wc -l) * 3 + 1 )) -le "$lines" ] || gap=0

printf '%s\n' "$rows" | while IFS="$(printf '\t')" read -r label pct right; do
  case $right in ????-??-??T*) right=$(resets "$right") ;; esac
  row "$label" "$right" "$pct"
done
wait_key
